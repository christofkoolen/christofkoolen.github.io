---
import AboutSection from '../components/AboutSection.astro';
import Hero from '../components/Hero.astro';
import PublicationsSection from '../components/PublicationsSection.astro';
import ResearchSection from '../components/ResearchSection.astro';
import { selectedPublicationTitles } from '../config/site';
import { publications } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const selectedPublications = publications.filter((publication) =>
  selectedPublicationTitles.has(publication.title)
);
---

<BaseLayout page="home">
  <Hero />
  <AboutSection />
  <ResearchSection />
  <PublicationsSection
    items={selectedPublications}
    heading="Selected publications"
    showAllLink
  />
</BaseLayout>
