---
import { talks } from '../data/site';
---

<section class="section" id="talks">
  <div class="section-heading">
    <p class="eyebrow">05</p>
    <h2>Talks</h2>
  </div>
  <div class="talk-list">
    {talks.map((talk) => (
      <article class="talk">
        <div class="talk-meta">
          <span>{talk.date}</span>
        </div>
        <div class="talk-content">
          <h3>{talk.title}</h3>
          <p class="talk-source">{talk.event}</p>
          {talk.location && <p class="talk-source">{talk.location}</p>}
          {talk.links.length > 0 && (
            <div class="talk-resources" aria-label={`Resources for ${talk.title}`}>
              <div class="talk-controls">
                {talk.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
                ))}
              </div>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
