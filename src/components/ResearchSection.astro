---
import { research } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section class="section" id="research">
  <SectionHeading eyebrow="02" title="Research">
    <p>My current research looks at how computational methods can support the field of law without losing sight of the human dimension.</p>
  </SectionHeading>

  <div class="card-grid">
    {research.map((item) => (
      <article class="research-card">
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </article>
    ))}
  </div>
</section>
