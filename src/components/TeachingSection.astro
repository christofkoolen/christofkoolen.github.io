---
import { teaching } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section class="section" id="teaching" aria-labelledby="teaching-heading">
  <SectionHeading eyebrow="04" title="Teaching" headingId="teaching-heading" />

  <div class="timeline">
    {teaching.map((item) => (
      <article class="timeline-item">
        <p class="timeline-date">{item.term}</p>
        <div>
          <h3>{item.title}</h3>
          <p class="item-subtitle">{item.role} · {item.institution}</p>
          <p>{item.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
