---
import '../styles/global.css';
import { profile } from '../data/site';

type PageKey = 'home' | 'publications' | 'teaching' | 'talks';

type NavigationItem = {
  label: string;
  href: string;
  page?: PageKey;
};

interface Props {
  page?: PageKey;
}

const { page = 'home' } = Astro.props;

const navigation: NavigationItem[] = [
  { label: 'about', href: '/#about' },
  { label: 'research', href: '/#research' },
  { label: 'publications', href: '/publications/#publications', page: 'publications' },
  { label: 'teaching', href: '/teaching/#teaching', page: 'teaching' },
  { label: 'talks', href: '/talks/#talks', page: 'talks' }
];

const pageMetadata = {
  home: {
    title: `${profile.name} | Law, AI and Computational Legal Research`,
    description: `${profile.name} researches law, artificial intelligence, legal information retrieval, and computational legal studies.`,
    canonicalPath: '/'
  },
  publications: {
    title: `Publications | ${profile.name}`,
    description: `${profile.name}'s books, journal articles, book chapters, blogs, and public-facing research.`,
    canonicalPath: '/publications/'
  },
  teaching: {
    title: `Teaching | ${profile.name}`,
    description: `${profile.name}'s teaching experience in artificial intelligence, technology, and law.`,
    canonicalPath: '/teaching/'
  },
  talks: {
    title: `Talks | ${profile.name}`,
    description: `${profile.name}'s talks, lectures, and conference presentations on law, artificial intelligence, and legal informatics.`,
    canonicalPath: '/talks/'
  }
} satisfies Record<PageKey, { title: string; description: string; canonicalPath: string }>;

const metadata = pageMetadata[page];
const canonicalUrl = new URL(metadata.canonicalPath, 'https://christofkoolen.com').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={metadata.description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f5f2eb" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{metadata.title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      document.documentElement.dataset.theme = savedTheme || 'light';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="wordmark" href="/" aria-label={`${profile.name}, home`}>
        <span>CK</span>
        <strong>{profile.name}</strong>
      </a>

      <nav id="primary-navigation" aria-label="Primary navigation">
        {navigation.map((item) => (
          <a
            href={item.href}
            aria-current={item.page === page ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="header-actions">
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-navigation"
        >
          Menu
        </button>
        <button class="theme-toggle" type="button" aria-label="Toggle colour theme">◐</button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {profile.name}</p>
    </footer>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
